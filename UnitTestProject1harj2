        [TestMethod]
        public void Account_1_1()
        { 
            //arrange
            int value = 10;
            double balance, expectedBalance = 10.0;
            Account account1 = new Account(1);
            Account account2 = new Account(1);



            //act

            account1.Transaction(10.0); //fix, now acc has balance

            //(from, to, value)
            new Transaction(account1, account2, value);
            balance = account2.Balance;

            //assert 
            Assert.AreEqual(expectedBalance, balance);
        }

